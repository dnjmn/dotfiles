{
  "description": "Backstage development validation hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/validate_yaml.py",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
